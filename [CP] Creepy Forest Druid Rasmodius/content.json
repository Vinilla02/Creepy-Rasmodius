{
  "Format": "2.8.0",
  "DynamicTokens": [
    //Portraits
    {
      "Name": "Portrait",
      "Value": "Vanilla"
    },
    {
      "Name": "Portrait",
      "Value": "LfL",
      "When": {
        "HasMod|contains=foggy.Lfl, mush.loveydovey": true
      }
    },
    {
      "Name": "Portrait",
      "Value": "SVE",
      "When": {
        "HasMod": "FlashShifter.StardewValleyExpandedCP"
      }
    },
    {
      "Name": "Portrait",
      "Value": "RomRas",
      "When": {
        "Query: '{{Spiderbuttons.CMCT/Config: Wolf.RomRas, Portrait Mode |contains= 9 Expressions, NineExpressions}}' = 'true'": true
      }
    },
    {
      "Name": "Portrait",
      "Value": "RomRas",
      "When": {
        "Query: '{{Spiderbuttons.CMCT/Config: Parrot.RomRas, Portrait Mode}}' = '9'": true
      }
    },
    {
      "Name": "Portrait",
      "Value": "LfL",
      "When": {
        "Query: '{{Spiderbuttons.CMCT/Config: Parrot.RomRas, Portrait Mode}}' = '12'": true,
      }
    },
    {
      "Name": "Portrait",
      "Value": "SVE_RomRas_12",
      "When": {
        "Query: '{{Spiderbuttons.CMCT/Config: Parrot.RomRas, Portrait Mode}}' = '12'": true,
        "HasMod": "Nom0ri.RomRas"
      }
    },
    {
      "Name": "Portrait",
      "Value": "SVE_RomRas_12",
      "When": {
        "HasMod|contains=foggy.Lfl, mush.loveydovey": true,
        "HasMod": "Nom0ri.RomRas"
      }
    },
    //Spritesheets
    {
      "Name": "Spritesheet",
      "Value": "Vanilla",
    },
    {
      "Name": "Spritesheet",
      "Value": "RomRas",
      "When": {
        "HasMod|contains=foggy.LfL, Wolf.RomRas": true 
      }
    },
    {
      "Name": "Spritesheet",
      "Value": "SVE",
      "When": {
        "HasMod": "FlashShifter.StardewValleyExpandedCP"
      }
    },
    //Gender
    {
      "Name": "Gender",
      "Value": "Male"
    },
    {
      "Name": "Gender",
      "Value": "Female",
      "When": {
        "HasMod": "Nom0ri.RomRas"
      }
    },
    {
      "Name": "Gender",
      "Value": "Female",
      "When": {
        "HasFlag": "DSVTeam.DiverseStardewValley_DSVWizardFemale",
        "Query: '{{Spiderbuttons.CMCT/Config: DSV.Core, GenderfluidWizard}}' = 'True'": true
      }
    },
    //Spouse portrait mods
    {
      "Name": "SPR",
      "Value": "",
      "When": {
        "HasMod|contains=Hitme.SpousePortraitsReworked": false
      }
    },
    {
      "Name": "SPR",
      "Value": "SPR_",
      "When": {
        "HasMod": "Hitme.SpousePortraitsReworked"
      }
    },
    {
      "Name": "SPRVariant",
      "Value": "",
      "When": {
        "HasMod|contains=Hitme.SpousePortraitsReworked": false
      }
    },
    {
      "Name": "SPRVariant",
      "Value": "{{Spiderbuttons.CMCT/Config: Hitme.SpousePortraitsReworked, WizardVariation}}",
      "When": {
        "HasMod": "Hitme.SpousePortraitsReworked"
      }
    },
    {
      "Name": "SPRRecolor",
      "Value": "",
    },
    {
      "Name": "SPRRecolor",
      "Value": "_TonedDown",
      "When": {
        "Query: '{{Spiderbuttons.CMCT/Config: Hitme.SpousePortraitsReworked, PortraitRecolor}}' = 'Tonedown'": true
      }
    }
  ],
  "Changes": [
    {
      "LogName": "Sprites",
      "Action": "EditImage",
      "Target": "Characters/Wizard, Characters/Wizard_Seasonal, Characters/Wizard_SpiritsEve, Characters/Wizard_WizardGender",
      "FromFile": "Assets/{{Gender}}/Characters/Wizard_{{Spritesheet}}.png",
      "Priority": "Late + 10"
    },
    {
      "LogName": "Portraits",
      "Action": "EditImage",
      "Target": "Portraits/Wizard, Portraits/Wizard_Seasonal, Portraits/Wizard_SpiritsEve, Portraits/Wizard_WizardGender",
      "FromFile": "Assets/{{Gender}}/Portraits/Wizard_{{Portrait}}.png",
      "Priority": "Late + 10"
    },
    {
      "LogName": "Robe Sprites",
      "Action": "EditImage",
      "Target": "Characters/Wizard_NewRobe",
      "FromFile": "Assets/{{Gender}}/Characters/Wizard_{{Portrait}}_robe.png",
      "When": {
        "HasMod": "Inmognito.wizrobe",
        "HasMod|contains=FlashShifter.StardewValleyExpandedCP,Nom0ri.RomRas": false
      },
      "Priority": "Late + 10",
    },
    {
      "LogName": "Robe Portraits",
